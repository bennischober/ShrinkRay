# systemd unit for the ShrinkRay resident app (Linux / NAS deployment).
#
# Install (as the user who runs the app):
#   sudo cp deploy/shrinkray.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now shrinkray
#
# Read the logs:
#   journalctl --user-unit shrinkray -f        (if User= is your user)
#   sudo journalctl -u shrinkray -f            (system-wide)
#
# The app is a polite guest by design: long encodes/probes run below normal
# priority (POSIX: the process nices itself at startup) and every encode can
# be thread-capped via config (handbrake.max_threads) so a media server on
# the same box keeps its cores. No unit-level Nice= needed - but you can add
# "Nice=10" and "IOSchedulingClass=idle" if you want the whole process
# (including scans) demoted too.

[Unit]
Description=ShrinkRay resident app (library catalog, quality encodes, dashboard)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# %i is the username from the instance name: "systemctl enable --now shrinkray@benni"
# Alternative: replace %i with a fixed username and copy the file without @.
User=%i
# the app was installed via the README's Linux section (uv tool or venv):
ExecStart=/home/%i/.local/bin/shrinkray serve --db /home/%i/.shrinkray/metadata.db
Restart=on-failure
RestartSec=5
# sqlite durability on power loss: the db lives in the home dir; keep at
# least the default journaling. A media server box rarely loses power, but
# a NAS might - consider an UPS for write-heavy setups.

[Install]
WantedBy=multi-user.target
