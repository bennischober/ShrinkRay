# ignore scan/encode output files (txt/csv/json at the repo root)
/movies.txt
/output.csv
/report.html
/config.json.bak
/*.json
!config.json
# the container's baked config (the Dockerfile COPYes it, see issue #204's
# extensions list and the 2026-10-25 hygiene rework)
!container-config.json

# sqlite database
*.db

# don't ignore config files
!config.json
!.devcontainer/devcontainer.json
!.vscode/settings.json
!src/shrinkray/models/*.json
# ui manifests (npm ci requires package.json + lockfile together; the
# tsconfigs are needed by svelte-check)
!ui/package.json
!ui/package-lock.json
!ui/tsconfig.json
!ui/tsconfig.app.json
!ui/tsconfig.node.json

## uv / python
.venv/
__pycache__/
*.py[cod]

# opencode: see .opencode/.gitignore for the local-exclusion rules

# impeccable design workspace (local working state; decision history stays in git history)
.impeccable/

# sqlite WAL sidecars
metadata.db-shm
metadata.db-wal
*.db-shm
*.db-wal

# playwright verification artifacts (screenshots + throwaway shot scripts)
ui/screens/
ui/shots*.cjs
ui/shots*.png

# node (ui build artifacts are rebuilt from source)
node_modules/
dist/

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/

# Unit test / coverage reports
.coverage
.coverage.*
.pytest_cache/
.ruff_cache/
htmlcov/

# Environments
.env
.venv
env/
venv/

# Editors
.idea/

# test media (copyright, too large for git)
test_media/

# generated reports
report.html

# local scratch: working notes kept out of the repository on purpose
# (ticket bodies live on GitHub; this file is a personal index, not source)
ISSUES.md

.opencode
.omo

# local test media: the folder is part of the repository, its contents never are
# (`test_media/` alone would ignore the directory itself, so the README exception
# could not apply; `/*` ignores everything inside, subfolders included)
/test_media/*
!/test_media/README.md
.import_linter_cache/
